# Supabase
SUPABASE_URL=https://ctpgmhixlaxnhhrnkazz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# ^ Service role key, NOT the anon key. Find it in Supabase dashboard:
#   Project Settings -> API -> service_role (secret). This key bypasses
#   Row Level Security, so it must only ever live on this server, never
#   in frontend code or committed to git.

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# ^ Set when you create the webhook in the Razorpay Dashboard
#   (Settings -> Webhooks). This is DIFFERENT from RAZORPAY_KEY_SECRET.

PORT=3000
